---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Ankur Singhal is an exposure scientist and data scientist who works on chemical exposure in water, air, and consumer products.',
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} | Ankur Singhal` : 'Ankur Singhal, exposure scientist';
// Pages are built as about.html etc. but served without the extension, so the canonical drops it.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/img/og-card.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ankur Singhal',
  url: 'https://www.ankursinghal.me',
  image: new URL('/img/og-card.png', Astro.site).href,
  jobTitle: 'Principal Scientist',
  worksFor: { '@type': 'Organization', name: 'Environmental Health & Engineering (EH&E)', url: 'https://www.eheinc.com' },
  knowsAbout: ['Exposure assessment', 'Risk assessment', 'Environmental data analysis', 'PFAS', '1,4-Dioxane', 'Ethylene oxide', 'Lead', 'Respirable crystalline silica', 'Data pipelines', 'AI tools and agents'],
  sameAs: ['https://linkedin.com/in/ankursing', 'https://github.com/aksinghal86'],
};
const showPerson = cleanPath === '/' || cleanPath === '/about';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Ankur Singhal" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ankur Singhal: exposure science, data, and AI" />
    <meta name="twitter:card" content="summary_large_image" />
    {showPerson && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
