---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('litigation')).sort((a, b) => a.data.order - b.data.order);
const main = all.filter((c) => c.data.group === 'main');
const other = all.filter((c) => c.data.group === 'other');
---

<Base
  title="Litigation and expert work"
  description="Exposure assessment, source attribution, and data support for legal teams, organized by chemical."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Litigation and expert work</h1>
      <p class="lede">
        I assess exposure and risk from chemicals in water, air, and consumer products. I also provide legal teams with data management and data analytics support for their cases.
      </p>
    </div>

    <div class="prose">
      <p>
        This page gives a snapshot of the evaluations I have conducted by chemical.
        My <a href="/cv">CV</a> has the full professional history.
      </p>
    </div>

    <h2>By chemical</h2>
    <div class="index" role="list">
      <div class="index-head" aria-hidden="true"><span>Chemical</span><span>Medium</span><span>The work</span></div>
      {main.map((c) => (
        <div class="index-row" id={c.id} role="listitem">
          <h3>{c.data.chemical}</h3>
          <div class="medium">{c.data.medium}</div>
          <p>{c.data.summary}</p>
        </div>
      ))}
    </div>

    <h2>Also</h2>
    <div class="index" role="list">
      {other.map((c) => (
        <div class="index-row" id={c.id} role="listitem">
          <h3>{c.data.chemical}</h3>
          <div class="medium">{c.data.medium}</div>
          <p>{c.data.summary}</p>
        </div>
      ))}
    </div>

    <h2>Data and analytics support for legal teams</h2>
    <div class="prose">
      <p>
        Cases with large data or document components need infrastructure whether or not an expert is testifying. I can set that up independently of expert work:
      </p>
    </div>
    <dl class="plain-list">
      <dt>Intake and harmonization</dt>
      <dd>Combining data of all kinds, including lab reports, spreadsheets, and monitoring data, into one clean, documented dataset.</dd>
      <dt>Dashboards</dt>
      <dd>Maps, charts, and tables that let the legal team and experts explore the data and find the story themselves.</dd>
      <dt>Gap analysis</dt>
      <dd>Finding what the data cannot yet support, and what would close the gap to make the case stronger.</dd>
      <dt>Follow-on recommendations</dt>
      <dd>Sampling and analysis plans, additional analyses, and next steps.</dd>
    </dl>
    <div class="prose">
      <p><a href="/contact">Tell me about the matter</a> and what you have, and I will tell you what I can do with it.</p>
    </div>
  </div>
</Base>
