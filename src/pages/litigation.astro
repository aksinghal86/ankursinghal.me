---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('litigation')).sort((a, b) => a.data.order - b.data.order);
const main = all.filter((c) => c.data.group === 'main');
const other = all.filter((c) => c.data.group === 'other');
const software = await getCollection('software', (p) => !p.data.hidden);
const toolsFor = (ids: string[]) => ids.map((id) => software.find((p) => p.id === id)).filter((p) => p !== undefined);
---

<Base
  title="Litigation and expert work"
  description="Exposure assessment, source attribution, and data support for legal teams, organized by chemical."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Litigation and expert work</h1>
      <p class="lede">
        I assess exposure and risk from chemicals in water, air, and consumer products. I also provide legal teams with <a href="/software#litigation-data">data management and data analytics support</a> for their cases, without being a named expert witness.
      </p>
    </div>

    <div class="prose">
      <p>
        This page gives a snapshot of the evaluations I have conducted by chemical.
        My <a href="/cv">CV</a> has the full professional history.
      </p>
    </div>

    <h2>By chemical</h2>
    <div class="index" role="list">
      <div class="index-head" aria-hidden="true"><span>Chemical</span><span>Medium</span><span>The work</span></div>
      {main.map((c) => (
        <div class="index-row" id={c.id} role="listitem">
          <h3>{c.data.chemical}</h3>
          <div class="medium">{c.data.medium}</div>
          <div class="summary">
            {c.data.summary.split(/\n\s*\n|\n/).map((t) => t.trim()).filter(Boolean).map((t) => <p>{t}</p>)}
            {toolsFor(c.data.tools).map((p) => <p class="tool-link"><a href={`/software/${p.id}`}>{p.data.title}</a></p>)}
          </div>
        </div>
      ))}
    </div>

    <h2>Also</h2>
    <div class="index" role="list">
      {other.map((c) => (
        <div class="index-row" id={c.id} role="listitem">
          <h3>{c.data.chemical}</h3>
          <div class="medium">{c.data.medium}</div>
          <div class="summary">{c.data.summary.split(/\n\s*\n|\n/).map((t) => t.trim()).filter(Boolean).map((t) => <p>{t}</p>)}</div>
        </div>
      ))}
    </div>

    <div class="prose">
      <p>
        Need help organizing and analyzing case data, with or without an expert? See <a href="/software#litigation-data">data and analytics support for legal teams</a>, or <a href="/contact">tell me about the matter</a>.
      </p>
    </div>
  </div>
</Base>
