---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DecayChart from '../components/DecayChart.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

const chemicals = (await getCollection('litigation'))
  .filter((c) => c.data.group === 'main')
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const shortName = (s: string) => s.replace(/\s*\(.*\)/, '').replace(/ and chlorinated solvents/, '');
---

<Base>
  <section class="intro">
    <div class="wrap">
      <div>
        <h1>Ankur Singhal</h1>
        <p class="role">Exposure scientist, data scientist, and software developer</p>
        <p class="employer">Principal Scientist, Advanced Analytics, at Environmental Health &amp; Engineering (EH&amp;E)</p>
        <ul class="social" aria-label="Elsewhere">
          <li>
            <a href="https://github.com/aksinghal86" rel="me" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/ankursing" rel="me" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
          </li>
          <li>
            <a href="/contact" aria-label="Contact form">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v.38l-10 6.25L2 5.88V5.5Zm0 2.73V18.5A1.5 1.5 0 0 0 3.5 20h17a1.5 1.5 0 0 0 1.5-1.5V8.23l-9.47 5.92a1 1 0 0 1-1.06 0L2 8.23Z"/></svg>
            </a>
          </li>
        </ul>
        <p>
          I use quantitative data science techniques to solve exposure assessment problems in air, water, and consumer products.
          Lately I have been busy with source attribution of PFAS in contaminated drinking water, cancer risk from ethylene oxide emissions, and the dashboards and software that let clients see and check the results.
        </p>
        <p>My goal is to bring data science and software development technologies to modernize the field of exposure assessment.</p>
        <p><a href="/about">About me</a></p>
      </div>
      <Image class="portrait" src={portrait} alt="Portrait of Ankur Singhal" width={640} height={640} />
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <div>
        <h2>Who was exposed, to what, and how much?</h2>
        <p>
          That is the question behind nearly all of my work, in litigation, regulation, and research.
          I answer it with sampling, models, and data, and I build the tools that let other people check the answer.
        </p>
      </div>
      <DecayChart />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="paths">
        <li>
          <a href="/litigation">
            <span class="name">Litigation and expert work</span>
            <span class="desc">Exposure assessment, source attribution, and data support for legal teams, organized by chemical.</span>
          </a>
        </li>
        <li>
          <a href="/software">
            <span class="name">Software and AI</span>
            <span class="desc">Dashboards, AI tools, and AI integration work, from public apps to client platforms.</span>
          </a>
        </li>
        <li>
          <a href="/research">
            <span class="name">Research</span>
            <span class="desc">Peer-reviewed papers, preprints, and conference talks.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Chemicals I work on</h2>
      <p class="chem-strip">
        {chemicals.map((c, i) => (
          <>
            <a href={`/litigation#${c.id}`}>{shortName(c.data.chemical)}</a>
            {i < chemicals.length - 1 && <span aria-hidden="true">/</span>}
          </>
        ))}
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Recent writing</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
              <div>
                <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <h2>Work with me</h2>
      <div class="prose">
        <p>
          I take on expert and consulting work, data and analytics support for legal teams, and collaborations on dashboards and exposure models.
          <a href="/contact">Send me a message</a> or read the <a href="/cv">CV</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
