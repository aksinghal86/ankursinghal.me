---
import Base from '../layouts/Base.astro';
// Messages go to Netlify Forms. See them in the Netlify dashboard under Forms > contact,
// and set email notifications there (Site configuration > Notifications > Emails and webhooks).
---

<Base title="Contact" description="Contact Ankur Singhal about expert work, litigation data support, or collaboration.">
  <div class="wrap">
    <div class="page-head">
      <h1>Contact</h1>
      <p class="lede">
        Write to me about consulting or expert work, data and analytics support for a legal matter, or a collaboration on dashboards, language models, or exposure modeling.
      </p>
    </div>

    <form class="form" id="contact" name="contact" method="POST" action="/contact-thanks" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <label>
        Name
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Message
        <textarea name="message" required></textarea>
      </label>
      <label class="hp" aria-hidden="true">
        Leave this empty
        <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
      <div>
        <button class="btn" type="submit">Send message</button>
      </div>
      <p class="form-status" id="status" role="status" aria-live="polite"></p>
    </form>
  </div>

  <script>
    const form = document.getElementById('contact') as HTMLFormElement | null;
    const status = document.getElementById('status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      status.dataset.state = '';
      status.textContent = 'Sending...';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (res.ok) {
          form.reset();
          status.textContent = 'Message sent. I will reply by email.';
        } else {
          throw new Error('failed');
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'The message did not send. Check your connection and try again, or reach me on LinkedIn.';
      }
    });
  </script>
</Base>
