---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);
const kinds = [
  { name: 'Dashboards and data tools', blurb: 'Interactive maps, charts, and pipelines that turn exposure data into something a person can explore.' },
  { name: 'AI tools', blurb: 'Tools that use machine learning and language models to find structure in text and data.' },
  { name: 'AI integration and agents', blurb: 'Connecting language models to real data and workflows: agents, MCP servers, and review pipelines.' },
] as const;
---

<Base
  title="Software and AI"
  description="Dashboards, AI tools, and AI integration work by Ankur Singhal: agents, MCP servers, language model workflows, and data pipelines."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Software and AI</h1>
      <p class="lede">
        I develop AI tools, integrate language models into analysis and reporting workflows, build agents and MCP servers, and make the dashboards and data pipelines underneath them.
      </p>
    </div>
    <div class="prose">
      <p class="meta">
        Public projects show screenshots. Client work is described without details, and its thumbnail is an illustration, not the real thing.
      </p>
    </div>

    {kinds.map((kind) => {
      const items = projects.filter((p) => p.data.kind === kind.name);
      return items.length > 0 && (
        <section class="group">
          <h2>{kind.name}</h2>
          <p class="group-blurb">{kind.blurb}</p>
          <ul class="projects">
            {items.map((p) => {
              const href = p.data.detail ? `/software/${p.id}` : undefined;
              return (
                <li class="project">
                  {p.data.image && (
                    href
                      ? <a class="thumb-link" href={href} tabindex="-1" aria-hidden="true"><img class="thumb" src={p.data.image} alt="" width="640" height="480" loading="lazy" /></a>
                      : <img class="thumb" src={p.data.image} alt={p.data.imageAlt} width="640" height="480" loading="lazy" />
                  )}
                  <div>
                    <h3>{href ? <a href={href}>{p.data.title}</a> : p.data.title}</h3>
                    <span class="status" data-status={p.data.status}>{p.data.status}</span>
                    <p>{p.data.summary}</p>
                    {p.data.stack.length > 0 && <p class="meta">{p.data.stack.join(', ')}</p>}
                    {(p.data.links.length > 0 || p.data.detail) && (
                      <ul class="links">
                        {p.data.detail && <li><a href={href}>Read more</a></li>}
                        {p.data.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
                      </ul>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
