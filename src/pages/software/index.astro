---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('software', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const kinds = [
  { id: 'litigation-data', name: 'Litigation data support, apps, and dashboards', blurb: 'Data platforms, dashboards, and applications that help teams interrogate large sampling, exposure, and document datasets.' },
  { id: 'ai-tools', name: 'Software, AI tools, integration, and agents', blurb: 'Applications and tools that use language models and machine learning, plus agents that connect models to real data and workflows.' },
] as const;
---

<Base
  title="Software, AI, and data systems"
  description="Apps, dashboards, AI tools, and agents by Ankur Singhal: language model workflows, MCP servers, and data pipelines."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Software, AI, and data systems</h1>
      <p class="lede">
        I build data systems, dashboards, and software for complex analysis. My work includes AI-assisted tools, language-model integrations, and agents that connect models to real data and workflows.
      </p>
    </div>
    <!-- <div class="prose">
      <p class="meta">
        Public projects show screenshots. Client work is described without details, and its thumbnail is an illustration, not the real thing.
      </p>
    </div> -->

    {kinds.map((kind) => {
      const items = projects.filter((p) => p.data.kind === kind.name);
      return items.length > 0 && (
        <section class="group" id={kind.id}>
          <h2>{kind.name}</h2>
          <p class="group-blurb">{kind.blurb}</p>
          {kind.id === 'litigation-data' && (
            <div class="service">
              <div class="service-pitch">
                <p class="service-kicker">Service for legal teams</p>
                <p>
                  Large, document-heavy cases need reliable data infrastructure, whether or not an expert is testifying. I build that foundation as a separate service.
                </p>
                <p>
                  AI can accelerate the extraction of information from scanned lab reports and spreadsheets, as well as repetitive data-cleaning tasks. The results still need review by someone who understands the chemistry, sampling, and case context. That expertise is essential to reliable results.
                </p>
                <p><a class="btn" href="/contact">Tell me about the matter</a></p>
              </div>
              <dl class="service-list">
                <div>
                  <dt>Data intake and standardization</dt>
                  <dd>Lab reports, spreadsheets, and monitoring data combined into one clean, documented dataset.</dd>
                </div>
                <div>
                  <dt>Dashboards</dt>
                  <dd>Maps, charts, and tables that let the legal team and experts explore the data themselves.</dd>
                </div>
                <div>
                  <dt>Gap analysis</dt>
                  <dd>What the data cannot yet support, and what would close the gap.</dd>
                </div>
                <div>
                  <dt>Recommended next steps</dt>
                  <dd>Sampling and analysis plans, additional analyses, and next steps.</dd>
                </div>
              </dl>
            </div>
          )}
          {kind.id === 'litigation-data' && <p class="service-kicker projects-label">Tools I have built for legal teams</p>}
          <ul class="projects">
            {items.map((p) => {
              const href = `/software/${p.id}`;
              return (
                <li class="project">
                  {p.data.image && (
                    <a class="thumb-link" href={href} tabindex="-1" aria-hidden="true"><img class="thumb" src={p.data.image} alt="" width="640" height="480" loading="lazy" /></a>
                  )}
                  <div>
                    <h3><a href={href}>{p.data.title}</a></h3>
                    <span class="status" data-status={p.data.status}>{p.data.status}</span>
                    <p>{p.data.summary}</p>
                    {p.data.stack.length > 0 && <p class="meta">{p.data.stack.join(', ')}</p>}
                    <p class="more"><a href={href}>Details<span class="sr-only"> on {p.data.title}</span></a></p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
